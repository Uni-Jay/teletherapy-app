# ---------- App ----------
NEXT_PUBLIC_APP_NAME=MindBridge
# Your live address, e.g. https://www.yourdomain.com (used in emails and payment links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret – server only, never share
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Paystack (Settings → API Keys & Webhooks) ----------
PAYSTACK_SECRET_KEY=sk_test_xxx
# Plan codes from Paystack → Products → Plans (monthly). Leave blank to take one-off monthly payments instead.
PAYSTACK_PLAN_BASIC=
PAYSTACK_PLAN_STANDARD=
PAYSTACK_PLAN_PREMIUM=
PAYSTACK_PLAN_FAMILY=
# Set to "false" to let patients book without an active plan (useful while testing)
REQUIRE_SUBSCRIPTION_TO_BOOK=true

# ---------- AI assessment (console.anthropic.com) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- Email (resend.com) ----------
RESEND_API_KEY=
EMAIL_FROM=MindBridge <hello@yourdomain.com>
# Gets an email whenever an assessment is flagged high-risk
ADMIN_ALERT_EMAIL=

# ---------- SMS (termii.com) ----------
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# ---------- Video (Jitsi) ----------
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
JITSI_ROOM_PREFIX=mb

# ---------- Reminders cron ----------
# Any long random string. The scheduler must send it as "Authorization: Bearer <value>" or ?secret=<value>
CRON_SECRET=
